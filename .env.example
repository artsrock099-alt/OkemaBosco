# ---------------------------------------------------------------------------
# Bosco Okema - environment configuration
#
# Copy to `.env` (development) or provide as real environment variables in
# production. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Local development (docker compose maps Postgres to 5435 on the host):
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/okema_bosco?schema=public"
# Inside Docker / production, use the service name instead:
# DATABASE_URL="postgresql://postgres:postgres@db:5432/okema_bosco?schema=public"

# --- Authentication ---------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3001"

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR="public/uploads"

# --- Seed / first administrator --------------------------------------------
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Email (Resend) ---------------------------------------------------------
# Server-side only. Never expose these to the browser.
RESEND_API_KEY=""
# Signing secret from the Resend webhook settings, used to verify webhooks.
RESEND_WEBHOOK_SECRET=""
# Optional: Resend audience used to mirror newsletter subscribers.
RESEND_AUDIENCE_ID=""

# Sender identity. Use a verified domain address in production, for example
# "Bosco Okema <hello@okemabosco.com>". A personal Gmail address cannot be
# verified with Resend and will be rejected.
EMAIL_FROM=""
EMAIL_REPLY_TO=""
EMAIL_FROM_NAME="Bosco Okema"

# Where admin notification emails are delivered. Falls back to the email of
# the first SUPER_ADMIN when left empty.
ADMIN_NOTIFICATION_EMAIL=""

# --- Security ---------------------------------------------------------------
# 32+ byte key used to encrypt TOTP secrets at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=""

# Optional: protects the scheduled-jobs endpoint (/api/cron/newsletter).
CRON_SECRET=""

# --- Newsletter behaviour ---------------------------------------------------
# "true"  = new subscribers start as PENDING and must confirm by email
# "false" = new subscribers become ACTIVE immediately (default)
NEWSLETTER_DOUBLE_OPT_IN="false"

# --- Diagnostics ------------------------------------------------------------
# "true" logs every Prisma query. Very noisy, development only.
PRISMA_LOG_QUERY="false"
